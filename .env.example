# ==============================================================================
# PUBLIC TEMPLATE CONFIGURATION (.env.example)
# Copy this file to .env and populate with your own private credentials.
# Never commit real API keys or secrets to public repositories.
# ==============================================================================

# Gemini AI API Key (Configured via Secrets panel or environment)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Application Host URL
APP_URL="http://localhost:3000"

# Firebase Cloud Firestore & Auth Credentials (Vite Client Variables)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"
